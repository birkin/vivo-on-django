# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings (SQLite by default)
# Uncomment and set these if using MySQL in production
# MYSQL_NAME=vivo_db
# MYSQL_USER=db_user
# MYSQL_PASSWORD=db_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# VIVO API settings
VIVO_API_URL=https://vivo.brown.edu/
VIVO_API_TIMEOUT=30

# Cache settings
CACHE_TIMEOUT=3600  # 1 hour
